{
  "openapi": "3.0.0",
  "paths": {
    "/me": {
      "get": {
        "operationId": "AuthController_me",
        "summary": "Return the current authenticated identity",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmIResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_liveness",
        "summary": "Liveness probe - is the service running?",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "HealthController_readiness",
        "summary": "Readiness probe - is the service ready to receive traffic?",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "VersionController_getVersion",
        "summary": "Service name and version",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Version"
        ]
      }
    },
    "/health/integrations": {
      "get": {
        "operationId": "IntegrationHealthController_integrations",
        "summary": "Connectivity status of configured integrations (UP/DOWN/DISABLED)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationHealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/technicians": {
      "get": {
        "operationId": "TechniciansController_list",
        "summary": "List technicians for scheduling",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TechniciansResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing technician.read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Technician data source unavailable/not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Technicians"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/webhooks/worksuite": {
      "post": {
        "operationId": "WorksuiteWebhookController_receive",
        "summary": "Receive a WorkSuite contractor lifecycle webhook",
        "parameters": [
          {
            "name": "x-worksuite-timestamp",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-worksuite-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-worksuite-event-id",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorksuiteWebhookResponse"
                }
              }
            }
          },
          "401": {
            "description": "Signature/timestamp/event-id verification failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Webhook disabled or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "WorkSuite Webhooks"
        ]
      }
    },
    "/api/auth/technician/login": {
      "post": {
        "operationId": "TechnicianAuthController_login",
        "summary": "Technician / Lead Technician login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TechnicianLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TechnicianLoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials (generic authentication failure)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Login data source or token issuer not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "info": {
    "title": "TEMA Middleware API",
    "description": "Enterprise integration middleware platform. Foundation endpoints only (health, readiness, version, integration health, identity). External business integrations (FSM, FSM Scheduler, Sage X3, SQL, WorkSuite, Lead Perfection) are NOT implemented yet.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "Version",
      "description": "Service version information"
    },
    {
      "name": "Auth",
      "description": "Authenticated identity"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Bearer token issued by the configured identity provider."
      }
    },
    "schemas": {
      "AuthenticatedUserDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "user-123"
          },
          "username": {
            "type": "string",
            "example": "jane.doe"
          },
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "roles": {
            "example": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "example": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identityProvider": {
            "type": "string",
            "example": "dev"
          }
        },
        "required": [
          "userId",
          "roles",
          "permissions",
          "identityProvider"
        ]
      },
      "WhoAmIResponse": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "example": true
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserDto"
          },
          "message": {
            "type": "string",
            "example": "Authentication is disabled"
          }
        },
        "required": [
          "authenticated"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "UP"
          },
          "service": {
            "type": "string",
            "example": "tema-middleware"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "READY"
          },
          "service": {
            "type": "string",
            "example": "tema-middleware"
          },
          "checks": {
            "type": "array",
            "description": "Individual readiness checks (empty in Phase 1).",
            "items": {
              "type": "object"
            },
            "example": []
          }
        },
        "required": [
          "status",
          "service",
          "checks"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "example": "tema-middleware"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": [
          "service",
          "version"
        ]
      },
      "IntegrationHealthItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "sql-server"
          },
          "targetSystem": {
            "type": "string",
            "example": "SQL Server"
          },
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN",
              "DISABLED"
            ],
            "example": "DISABLED"
          },
          "enabled": {
            "type": "boolean",
            "example": false
          },
          "latencyMs": {
            "type": "number",
            "example": 12
          },
          "message": {
            "type": "string",
            "example": "Integration disabled"
          }
        },
        "required": [
          "name",
          "targetSystem",
          "status",
          "enabled"
        ]
      },
      "IntegrationHealthResponse": {
        "type": "object",
        "properties": {
          "integrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntegrationHealthItem"
            }
          }
        },
        "required": [
          "integrations"
        ]
      },
      "TechnicianDto": {
        "type": "object",
        "properties": {
          "technicianId": {
            "type": "string",
            "example": "T-1001"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "status": {
            "type": "string",
            "example": "ACTIVE"
          },
          "branch": {
            "type": "string",
            "example": "Denver"
          },
          "region": {
            "type": "string",
            "example": "Mountain"
          },
          "crew": {
            "type": "string",
            "example": "Crew-7"
          },
          "skills": {
            "example": [
              "install",
              "service"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "technicianId"
        ]
      },
      "TechniciansResponse": {
        "type": "object",
        "properties": {
          "technicians": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TechnicianDto"
            }
          },
          "count": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "technicians",
          "count"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INTERNAL_ERROR",
            "description": "Stable, machine-readable error code."
          },
          "message": {
            "type": "string",
            "example": "An unexpected error occurred",
            "description": "Human-readable, safe error message (no internal details)."
          },
          "requestId": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "description": "Correlation / request id for tracing this call."
          },
          "details": {
            "type": "array",
            "description": "Optional field-level validation details.",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "WorksuiteWebhookResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "example": true
          },
          "eventId": {
            "type": "string",
            "example": "evt_01HXY..."
          },
          "event": {
            "type": "string",
            "example": "contractor.updated"
          },
          "status": {
            "type": "string",
            "example": "processed",
            "enum": [
              "processed",
              "ignored"
            ]
          }
        },
        "required": [
          "accepted",
          "eventId",
          "event",
          "status"
        ]
      },
      "TechnicianLoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "jdoe",
            "description": "Technician login username (XTECHNCN_0)"
          },
          "password": {
            "type": "string",
            "description": "Technician password",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "TechnicianIdentityDto": {
        "type": "object",
        "properties": {
          "technicianId": {
            "type": "string",
            "example": "TECH001",
            "description": "X3 technician id (XTECH_0)"
          },
          "username": {
            "type": "string",
            "example": "jdoe",
            "description": "Login username (XTECHNCN_0)"
          },
          "role": {
            "type": "string",
            "example": "Technician",
            "enum": [
              "Lead Technician",
              "Technician"
            ]
          }
        },
        "required": [
          "technicianId",
          "username",
          "role"
        ]
      },
      "TechnicianLoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer access token (JWT)"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 3600,
            "description": "Token lifetime in seconds"
          },
          "user": {
            "$ref": "#/components/schemas/TechnicianIdentityDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      }
    }
  }
}
